rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos do cardapio, capa e logo: qualquer pessoa pode ver,
    // so admin autenticado pode enviar/remover.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
